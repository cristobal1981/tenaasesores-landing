# URL pública del sitio
NEXT_PUBLIC_SITE_URL=https://www.tenaasesores.es

# Google Analytics 4 — ID de medición (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Syntia app base URL for onboarding proxy (sin barra final)
# Preview: URL del deploy de syntia, p. ej. https://syntia-app-xxx.vercel.app
SYNTIA_APP_URL=

# Shared secret for landing onboarding API calls (mismo valor en landing y syntia)
LANDING_ONBOARDING_API_SECRET=

# Si syntia preview tiene Deployment Protection en Vercel, copia aquí el
# "Protection Bypass for Automation" de syntia (Settings → Deployment Protection).
SYNTIA_VERCEL_PROTECTION_BYPASS=

# Odoo/n8n — creación de lead CRM (landing-crm-lead)
ODOO_LEAD_WEBHOOK_URL=https://n8n.stratosfera.es/webhook/landing-crm-lead
# Secreto compartido con la cabecera X-Webhook-Secret. Se reutiliza también
# para CONFIRMAR_PRESUPUESTO_WEBHOOK_URL (mismo secreto en ambos webhooks).
ODOO_LEAD_WEBHOOK_SECRET=

# Odoo/n8n — confirmación de presupuesto flash (aceptar / rechazar / no_interesa)
CONFIRMAR_PRESUPUESTO_WEBHOOK_URL=https://n8n.stratosfera.es/webhook/confirmar-presupuesto
